1class Solution {
2public:
3    bool dfs(int node, int clr, vector<vector<int>>& graph, vector<int>& color) {
4        color[node] = clr;
5
6        for (int nbr : graph[node]) {
7            if (color[nbr] == -1) {
8                if (!dfs(nbr, 1 - clr, graph, color))
9                    return false;
10            }
11            else if (color[nbr] == clr) {
12                return false;
13            }
14        }
15
16        return true;
17    }
18
19    bool isBipartite(vector<vector<int>>& graph) {
20        int n = graph.size();
21        vector<int> color(n, -1);
22
23        for (int i = 0; i < n; i++) {
24            if (color[i] == -1) {
25                if (!dfs(i, 0, graph, color))
26                    return false;
27            }
28        }
29
30        return true;
31    }
32};